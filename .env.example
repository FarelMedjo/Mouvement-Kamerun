# ----------------------------------------------------------------------------
# Configuration Supabase — Mouvement Kamerun
# ----------------------------------------------------------------------------
# Copiez ce fichier en « .env.local » puis renseignez vos valeurs.
# .env.local est ignoré par git : les clés ne sont JAMAIS committées.
#
# Où trouver ces valeurs :
#   Dashboard Supabase  ->  Project Settings  ->  API
#     - Project URL         => VITE_SUPABASE_URL
#     - Project API keys  ->  « anon » / « publishable »  => VITE_SUPABASE_ANON_KEY
#
# IMPORTANT : seule la clé « anon » (publique) va ici. La clé « service_role »
# ne doit JAMAIS être placée dans le front-end.
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON
